{
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/wrapper",
      "destination": "/wrapper.html"
    },
    {
      "source": "/launch",
      "destination": "/launch.html"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
